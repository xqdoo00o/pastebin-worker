+	// LocalAverage uses HybridBinarizer; GlobalHistogram bypasses this block-threshold SIMD path.
+	const auto thresholdVec = wasm_u8x16_splat(threshold);
+#endif
 	for (int y = yoffset; y < yoffset + BLOCK_SIZE; ++y) {
 		auto* src = luminances + y * rowStride + xoffset;
 		auto* const dstBegin = matrix.row(y).begin() + xoffset;
 		// TODO: fix pixelStride > 1 case
+#ifdef __wasm_simd128__
+		auto pixels = wasm_v128_load64_zero(src);
+		wasm_v128_store64_lane(dstBegin, wasm_u8x16_le(pixels, thresholdVec), 0);
+#else
 		for (auto* dst = dstBegin; dst < dstBegin + BLOCK_SIZE; ++dst, ++src)
 			*dst = (*src <= threshold) * BitMatrix::SET_V;
+#endif
 	}
 }
 
