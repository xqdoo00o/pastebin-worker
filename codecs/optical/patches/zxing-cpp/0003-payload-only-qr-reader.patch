 }
 
+std::vector<ByteArray> ReadStandardPayloads(const BinaryBitmap& image, int maxSymbols, const ReaderOptions& opts)
+{
+	std::vector<ByteArray> res;
+	if (maxSymbols > 0)
+		res.reserve(maxSymbols);
+
+	auto binImg = image.getBitMatrix();
+	if (binImg == nullptr || !opts.hasFormat(BarcodeFormat::QRCodeModel1 | BarcodeFormat::QRCodeModel2))
+		return res;
+
+	if (opts.isPure()) {
+		auto detectorResult = DetectPureQR(*binImg);
+		if (!detectorResult.isValid())
+			return res;
+		auto decoderResult = Decode(detectorResult.bits());
+		if (decoderResult.isValid()) {
+			auto content = std::move(decoderResult).content();
+			res.push_back(std::move(content.bytes));
+		}
+		return res;
+	}
+
+	auto allFPs = FindFinderPatterns(*binImg, opts.tryHarder());
+	auto allFPSets = GenerateFinderPatternSets(allFPs);
+	std::vector<ConcentricPattern> usedFPs;
+	usedFPs.reserve(res.capacity() * 3);
+	for (const auto& fpSet : allFPSets) {
+		if (Contains(usedFPs, fpSet.bl) || Contains(usedFPs, fpSet.tl) || Contains(usedFPs, fpSet.tr))
+			continue;
+
+		logFPSet(fpSet);
+		for (auto&& detectorResult : SampleQR(*binImg, fpSet)) {
+			auto decoderResult = Decode(detectorResult.bits());
+			if ((decoderResult.content().symbology.modifier == '0' && !opts.hasFormat(BarcodeFormat::QRCodeModel1))
+				|| (decoderResult.content().symbology.modifier == '1' && !opts.hasFormat(BarcodeFormat::QRCodeModel2)))
+				continue;
+			if (!decoderResult.isValid())
+				continue;
+
+			usedFPs.push_back(fpSet.bl);
+			usedFPs.push_back(fpSet.tl);
+			usedFPs.push_back(fpSet.tr);
+			auto content = std::move(decoderResult).content();
+			res.push_back(std::move(content.bytes));
+			break;
+		}
+		if (maxSymbols > 0 && Size(res) == maxSymbols)
+			break;
+	}
+	return res;
+}
+
 } // namespace ZXing::QRCode
