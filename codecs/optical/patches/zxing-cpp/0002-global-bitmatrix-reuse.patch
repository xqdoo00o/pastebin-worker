+static std::shared_ptr<BitMatrix> ReusableBitMatrix(int width, int height)
+{
+	static thread_local std::shared_ptr<BitMatrix> bits;
+
+	// BinaryBitmap holds the returned matrix for the lifetime of one read. Only
+	// reuse it after that owner is gone; a reentrant read receives fresh storage.
+	if (!bits || bits.use_count() != 1 || bits->width() != width || bits->height() != height)
+		bits = std::make_shared<BitMatrix>(width, height);
+
+	return bits;
+}
