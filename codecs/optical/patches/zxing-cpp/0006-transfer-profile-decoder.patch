+static DecoderResult DecodeTransferBitStream(ByteArray&& bytes, const Version& version)
+{
+	BitSource bits(bytes);
+	Content result;
+
+	try {
+		if (bits.readBits(4) != static_cast<int>(CodecMode::BYTE))
+			return FormatError("Transfer payload is not a byte segment");
+		const int count = bits.readBits(CharacterCountBits(CodecMode::BYTE, version));
+		if (count > bits.available() / 8)
+			return FormatError("Truncated transfer byte segment");
+
+		result.reserve(count);
+		for (int i = 0; i < count; ++i)
+			result.push_back(bits.readBits(8));
+
+		const int terminatorBits = std::min(4, bits.available());
+		if (terminatorBits && bits.readBits(terminatorBits) != 0)
+			return FormatError("Transfer payload has another segment");
+		const int alignmentBits = bits.available() & 7;
+		if (alignmentBits && bits.readBits(alignmentBits) != 0)
+			return FormatError("Invalid transfer byte alignment");
+		for (int pad = 0xEC; bits.available() >= 8; pad ^= 0xEC ^ 0x11)
+			if (bits.readBits(8) != pad)
+				return FormatError("Invalid transfer padding");
+	} catch (const std::out_of_range&) {
+		return FormatError("Truncated transfer bit stream");
+	}
+
+	return DecoderResult(std::move(result));
+}
