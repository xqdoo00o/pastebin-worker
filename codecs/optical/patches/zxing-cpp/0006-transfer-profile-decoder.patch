+FormatInformation FormatInformation::DecodeQRMask3(uint32_t formatInfoBits1, uint32_t formatInfoBits2)
+{
+	// Table C.1 entries whose low three data bits are mask 3, in ECC-bit order.
+	constexpr uint32_t MASK3_PATTERNS[] = {0x5B4B, 0x789D, 0x19D0, 0x3A06};
+	uint32_t mirroredFormatInfoBits2 = MirrorBits(((formatInfoBits2 >> 1) & 0b111111110000000) | (formatInfoBits2 & 0b1111111));
+	formatInfoBits2 = ((formatInfoBits2 >> 1) & 0b111111100000000) | (formatInfoBits2 & 0b11111111);
+	const uint32_t copies[] = {formatInfoBits1, formatInfoBits2, MirrorBits(formatInfoBits1), mirroredFormatInfoBits2};
+
+	FormatInformation fi;
+	for (int bitsIndex = 0; bitsIndex < 4; ++bitsIndex)
+		for (int ecBits = 0; ecBits < 4; ++ecBits)
+			if (int distance = std::popcount(copies[bitsIndex] ^ MASK3_PATTERNS[ecBits]); distance < fi.hammingDistance) {
+				fi.mask = FORMAT_INFO_MASK_MODEL2;
+				fi.data = static_cast<uint8_t>((ecBits << 3) | 3);
+				fi.hammingDistance = distance;
+				fi.bitsIndex = bitsIndex;
+			}
+	fi.ecLevel = ECLevelFromBits((fi.data >> 3) & 0x03);
+	fi.dataMask = static_cast<uint8_t>(fi.data & 0x07);
+	fi.isMirrored = fi.bitsIndex > 1;
 	return fi;
 }
 
