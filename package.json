{
  "private": true,
  "name": "pb",
  "version": "1.0.0",
  "description": "Pastebin based on Cloudflare worker",
  "repository": "https://github.com/SharzyL/pastebin-worker",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --var DEPLOY_URL:http://localhost:8787 INDEX_PAGE_TITLE:\"Pastebin Worker (dev)\" --port 8787",
    "delete-paste": "wrangler kv key delete --binding PB",
    "gentypes": "wrangler types --strict-vars false",
    "prebuild:frontend": "pnpm ensure:frontend-wasm",
    "build:frontend": "vite build frontend --outDir ../dist/frontend --emptyOutDir",
    "prebuild:frontend:dev": "pnpm ensure:frontend-wasm",
    "build:frontend:dev": "vite build frontend --mode development --outDir ../dist/frontend --emptyOutDir",
    "predev:frontend": "pnpm ensure:frontend-wasm",
    "dev:frontend": "vite serve frontend --mode development",
    "preview:frontend": "vite preview --outDir dist/frontend",
    "prebuild:optical-send": "pnpm ensure:frontend-wasm",
    "build:optical-send": "vite build --config frontend/vite.optical-send.config.js",
    "prebuild:optical-send:scalar": "pnpm ensure:frontend-wasm",
    "build:optical-send:scalar": "vite build --mode optical-send-scalar --config frontend/vite.optical-send.config.js",
    "prebuild:optical-receive": "pnpm ensure:frontend-wasm",
    "build:optical-receive": "vite build --config frontend/vite.optical-receive.config.js",
    "prebuild:optical-receive:scalar": "pnpm ensure:frontend-wasm",
    "build:optical-receive:scalar": "vite build --mode optical-receive-scalar --config frontend/vite.optical-receive.config.js",
    "setup:emscripten": "node codecs/emscripten/setup.mjs",
    "build:argon2": "node codecs/argon2/build.mjs",
    "build:nanorq": "node codecs/nanorq/build.mjs",
    "build:optical-codec": "node codecs/optical/build.mjs --output ../../frontend/optical/codec",
    "build:zstd": "node codecs/zstd/build.mjs",
    "build:xxhash": "node codecs/xxHash/build.mjs",
    "benchmark:zstd": "node codecs/zstd/benchmark.mjs",
    "ensure:argon2": "node scripts/ensure-codec.js argon2",
    "ensure:nanorq": "node scripts/ensure-codec.js nanorq",
    "ensure:optical-codec": "node scripts/ensure-codec.js optical",
    "ensure:zstd": "node scripts/ensure-codec.js zstd",
    "ensure:xxhash": "node scripts/ensure-codec.js xxhash",
    "ensure:frontend-wasm": "node scripts/ensure-codec.js nanorq optical zstd xxhash",
    "ensure:wasm": "node scripts/ensure-codec.js argon2 nanorq optical zstd xxhash",
    "fmt": "prettier --write .",
    "prelint": "pnpm ensure:wasm",
    "lint": "eslint .",
    "pretest": "pnpm ensure:wasm",
    "test": "vitest",
    "precoverage": "pnpm ensure:wasm",
    "coverage": "vitest run --coverage",
    "pretypecheck": "pnpm ensure:wasm",
    "typecheck": "tsc --noEmit",
    "password": "pnpm ensure:argon2 && node scripts/password.js"
  },
  "author": "SharzyL <me@sharzy.in>",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "toml": "^5.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10",
    "wrangler": "^4.123.0"
  },
  "prettier": {
    "singleQuote": false,
    "semi": false,
    "trailingComma": "all",
    "tabWidth": 2,
    "printWidth": 120
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@zip.js/zip.js": "^2.15.0",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "lean-qr": "^2.7.4",
    "marked": "^18.0.9",
    "mime": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "xss": "^1.0.15"
  }
}
